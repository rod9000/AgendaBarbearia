# Evolution API - Configuração
# Gere uma chave forte: openssl rand -hex 32
EVOLUTION_API_KEY=sua_chave_secreta_aqui

# URL pública do servidor (ex: http://localhost:8080 ou https://api.seusite.com)
SERVER_URL=http://localhost:8080

# Senha do banco PostgreSQL (opcional)
POSTGRES_PASSWORD=evolution_pass
